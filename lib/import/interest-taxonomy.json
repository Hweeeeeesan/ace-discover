{
  "version": 1,
  "maxInterests": 3,
  "placeholders": [
    "", ".", "..", "-", "--", "n/a", "na", "none", "no", "nope", "null",
    "not applicable", "not available", "did not submit", "didn't submit", "asdf"
  ],
  "blockedCustom": [
    "big", "little", "family", "role", "program", "hobby", "hobbies", "interest",

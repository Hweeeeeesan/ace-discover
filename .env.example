# -----------------------------------------------------------------------------
# Google Drive access
# -----------------------------------------------------------------------------
# Public individual Drive image links work without credentials. The server-side
# proxy tries public thumbnail/download endpoints and falls back locally.
#
# Credentials are recommended when Google Form uploads are private or when a
# spreadsheet cell contains a Drive folder. Share the upload folder with the
# service-account email as Viewer.
#
# The same credentials are also used by optional Admin Google Sheets sync.
# Enable Google Sheets API in this Cloud project and share each private master
# Sheet with the service-account email as Viewer. ACE Discover requests only
# Drive/Sheets read-only scopes and never edits a Sheet.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative: paste the full service-account JSON object on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Alternative for hosts where multiline or quoted secrets are awkward:
# base64-encode the entire downloaded service-account JSON file.
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional Google Workspace domain-wide delegation. Configure this only when
# your Workspace administrator has authorized the service account and scopes.
# GOOGLE_IMPERSONATED_USER=person@your-domain.edu

# Alternative for a Google Workspace user that already has access to every file.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# Temporary/manual alternative. Access tokens expire and should not be committed.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Optional for public Drive API requests. OAuth/service-account access is more
# reliable for private Form uploads and folder traversal.
# GOOGLE_DRIVE_API_KEY=

# -----------------------------------------------------------------------------
# Supabase Auth + semester datasets
# -----------------------------------------------------------------------------
# The URL and publishable key are safe browser configuration and are required
# for persistent Google OAuth sessions. The service-role key is server-only,
# bypasses Row Level Security, and must never use a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/local migration aliases. SUPABASE_URL may match the public URL above.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Server-only trusted production origin and authorization allowlist. Use
# http://localhost:3000 for local production-mode testing. Never trust an email
# or role supplied by the client.
ACE_APP_ORIGIN=https://discover.example.com
ACE_OWNER_EMAIL=hieusondang@gmail.com
ACE_ADMIN_EMAILS=hieuson.dang@sjsu.edu,acecommittee.sjsuvsa@gmail.com

# Public-content bucket used by server-side URL resolution and the local,
# dataset-scoped image migration tool. Keep the service-role key server-only.
# Example: npm run images:migrate -- spring-2026 --dry-run

SUPABASE_STORAGE_BUCKET=profile-images
